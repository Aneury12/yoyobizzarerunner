-- Scheduler/worker isolation: any game API can yield. A stuck update no longer
-- prevents future guard evaluations or manual block-check requests. Each worker
-- gets a serial; stale workers bail out before changing block state.
task.spawn(function()
    local nextMonitor=0
    local inFlight=false
    local started=0
    while alive do
        local now=os.clock()
        if inFlight and now-started>0.45 then
            guardTelemetry.stalls=guardTelemetry.stalls+1
            guardTelemetry.lastStall='stuck for '..string.format('%.2fs',now-started)..' at '..tostring(guardTelemetry.phase)
            diagPush('GUARD_STALL',guardTelemetry.lastStall,true)
            guardTelemetry.serial=guardTelemetry.serial+1
            inFlight=false
            guardTelemetry.phase='Recovered, scheduling next evaluation'
        end
        if not inFlight then
            inFlight=true
            started=now
            guardTelemetry.serial=guardTelemetry.serial+1
            local serial=guardTelemetry.serial
            guardTelemetry.updates=guardTelemetry.updates+1
            guardTelemetry.lastUpdate=now
            task.spawn(function()
                local ok,err=pcall(updateBlock,serial)
                if not alive or serial~=guardTelemetry.serial then return end
                if not ok then
                    guardTelemetry.faults=guardTelemetry.faults+1
                    lastBlockError=tostring(err):sub(1,140)
                    diagPush('GUARD_ERROR',lastBlockError,true)
                    if os.clock()-lastStatusTime>1 then
                        statusMessage('Auto Block update error: '..lastBlockError,true)
                        lastStatusTime=os.clock()
                    end
                else
                    guardTelemetry.completed=guardTelemetry.completed+1
                    guardTelemetry.lastComplete=os.clock()
                end
                inFlight=false
            end)
        end
        if now>=nextMonitor and combatLive then
            local ctrl=controllerCache.AttackController
            local move=controllerCache.MovementController
            local requested=(ctrl and ctrl.KeepBlocking==true) or false
            local actual=(move and move.States and move.States.Blocking==true) or false
            local age=guardTelemetry.lastComplete>0 and (now-guardTelemetry.lastComplete) or math.huge
            combatLive.Text=('Mode: %s | Guard: %s | Hold: %s | Actual block: %s | Attempts: %d | Guard age %.2fs | Stalls %d'):format(
                tostring(settings.blockMode),age<0.6 and 'running' or 'STALE',
                tostring(requested),tostring(actual),blockAttempts,age,guardTelemetry.stalls)
            nextMonitor=now+0.35
        end
        task.wait((settings.autoBlock or manualBlockStarted) and 0.055 or 0.22)
    end
end)
