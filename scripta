        end
    end
    if takeLock then
        local summary=chosen and (chosen.character.Name..' | '..string.format('%.1f',chosen.distance)..
            ' studs | '..tostring(chosen.kind or 'Proximity')..' | '..tostring(chosen.move or 'no specific move'))
            or (choosingBody and 'No active attacker in body-lock range' or 'No qualified guard target')
