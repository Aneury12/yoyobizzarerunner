                if d<=limit and (choosingBody or not settings.checkIfFacing or isFacing(part,root.Position,0.20)) then
                    kind,move=observedAttackKind(c,hum)
                    local isAttacking=(kind=='M1' or kind=='Skill')
                    local withinGuard=(kind=='Skill' and d<=settings.skillReactDistance)
                        or (d<=blockRange)
                    local entry={part=part,distance=d,kind=kind,move=move,character=c,attacking=isAttacking}
                    if choosingBody or withinGuard then
                        if isAttacking then attackers[#attackers+1]=entry
                        elseif (choosingBody and settings.blockMode=='Blatant' and d<=blockRange)
                            or (not choosingBody and d<=blockRange) then
