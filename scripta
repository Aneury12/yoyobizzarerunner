local function rideRayParams(horse)
    local ok,params=pcall(function() return horse:GetRaycastParams() end)
    if ok and params then return params end
    params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.RespectCanCollide=true
    local ignore={}
    if horse and horse.Model then table.insert(ignore,horse.Model) end
    if LocalPlayer.Character then table.insert(ignore,LocalPlayer.Character) end
    params.FilterDescendantsInstances=ignore
    return params
end
-- Return an actual obstacle hit, ignoring floor sweeps on ramps.
function raceLib.getObstruction(horse, origin, direction, reach)
    local flat=Vector3.new(direction.X,0,direction.Z)
    if flat.Magnitude<0.05 or not horse or not horse.Root then return nil end
    local params=rideRayParams(horse)
    local vec=flat.Unit*reach
    -- Model the collision size that HorseNew uses in HandleCrash.
    local hit=nil
    local ok,result=pcall(function() return workspace:Shapecast(horse.Root,vec,params) end)
    if ok and result and result.Normal.Y<0.62 then hit=result end
    local root=horse.Root
    for _,height in ipairs({1,3.5,6.5}) do
        local cast=workspace:Raycast(origin+Vector3.new(0,height,0),vec,params)
        if cast and cast.Normal.Y<0.62 and (not hit or cast.Distance<hit.Distance) then hit=cast end
    end
    return hit
end
local function isSafeGround(horse, point)
    local params=rideRayParams(horse)
    local hit=workspace:Raycast(point+Vector3.new(0,14,0),Vector3.new(0,-45,0),params)
    return hit~=nil and hit.Normal.Y>0.58 and math.abs(point.Y-hit.Position.Y)<23
end
function raceLib.chooseSteeringDirection(horse, desired)
    if not settings.raceAvoidObstacles or not horse or not horse.Root then return desired, false end
    local now=os.clock()
    if driveAvoidHeading and now-driveAvoidAt<0.12 then return driveAvoidHeading,driveBlockedAt>now end
    local root=horse.Root
    if driveDetour and now-driveDetourAt<5 then
        local around=raceLib.flat(driveDetour-root.Position)
        if around.Magnitude>12 then
            local aroundDir=around.Unit
            local detourHit=raceLib.getObstruction(horse,root.Position,aroundDir,math.min(around.Magnitude,60))
            if not detourHit then
                driveAvoidHeading=aroundDir;driveAvoidAt=now;driveBlockedAt=0
                return aroundDir,false
            end
        end
    end
    driveDetour=nil
    local speed=math.abs(horse.CurrentSpeed or 0)
    local reach=math.clamp(speed*1.3+24,32,145)
    local hit=raceLib.getObstruction(horse,root.Position,desired,reach)
    if not hit then
        driveAvoidHeading=desired;driveAvoidAt=now;driveBlockedAt=0
        return desired,false
    end
    local best,bestScore,bestSide=nil,-math.huge,0
    for _,angle in ipairs({0.28,-0.28,0.52,-0.52,0.82,-0.82,1.1,-1.1,1.42,-1.42}) do
        local candidate=CFrame.Angles(0,angle,0):VectorToWorldSpace(desired)
        local hitAhead=raceLib.getObstruction(horse,root.Position,candidate,reach)
        local clear=hitAhead and hitAhead.Distance or reach
        local sample=root.Position+candidate*math.min(clear*0.68,36)
        local goodGround=isSafeGround(horse,sample)
        local side=angle>0 and 1 or -1
        local score=clear - math.abs(angle)*12 + (not hitAhead and 28 or 0) +
            (side==driveAvoidSide and 17 or 0) - (not goodGround and 70 or 0)
        if score>bestScore then best,bestScore,bestSide=candidate,score,side end
    end
    driveAvoidAt=now
    if not best or bestScore<reach*0.20 then
        driveAvoidHeading=desired;driveBlockedAt=now+0.25
        return desired,true
    end
    driveAvoidSide=bestSide
    driveDetour=root.Position+best*math.min(reach*0.70,50)
    driveDetourAt=now
    driveAvoidHeading=best
    driveBlockedAt=0
    return best,false
end
local function startRidePath(horse, destination, goal)
    if not horse or not horse.Root then return end
    local now=os.clock()
    if ridePlan.planning or now-ridePlan.lastPlan<3.5 then return end
    -- Keep a useful path instead of recalculating it every few seconds.
    if ridePlan.points[ridePlan.index] and now-ridePlan.lastPlan<12 then return end
    ridePlan.lastPlan=now
    ridePlan.planning=true
    ridePlan.status='Calculating route'
    ridePlan.serial=ridePlan.serial+1
    local serial=ridePlan.serial
    local start=horse.Root.Position
    local endPoint=destination
    task.spawn(function()
        local path
        local success,err=pcall(function()
            path=PathfindingService:CreatePath({
                AgentRadius=math.max(4,settings.rideClearance), AgentHeight=7,
                AgentCanJump=false, AgentCanClimb=false, WaypointSpacing=14
            })
            path:ComputeAsync(start,endPoint)
        end)
        if not alive or serial~=ridePlan.serial then return end
        ridePlan.planning=false
        if success and path.Status==Enum.PathStatus.Success then
            local points={}
            for _,w in ipairs(path:GetWaypoints()) do table.insert(points,w.Position) end
            if #points>1 then
                ridePlan.points=points;ridePlan.index=2;ridePlan.failReason=nil
                ridePlan.status='Path '..tostring(#points)..' waypoints'
                return
            end
        end
        ridePlan.points={};ridePlan.index=1
        ridePlan.failReason=success and 'Navmesh found no horse-sized route' or tostring(err):sub(1,90)
        ridePlan.status='No path • sensor detours only'
    end)
end
function raceLib.rideWaypoint(horse, goalPart, goalPoint)
    if not horse or not horse.Root then return nil,'Horse unavailable' end
    local pos=horse.Root.Position
    local changed=ridePlan.goal~=goalPart or not ridePlan.goalPoint or
        (raceLib.flat(ridePlan.goalPoint-goalPoint)).Magnitude>18
    if changed then
        raceLib.clearRidePlan()
        ridePlan.goal=goalPart;ridePlan.goalPoint=goalPoint
    end
    if not settings.raceAvoidObstacles then return goalPoint,'Direct (avoidance off)' end
    if settings.rideRouting=='Pathfinder' then
        if not driveLastPosition or raceLib.flat(driveLastPosition-pos).Magnitude>7 then
            driveLastPosition=pos;driveLastMotionAt=os.clock()
        elseif os.clock()-driveLastMotionAt>4 and math.abs(horse.CurrentSpeed or 0)<7 then
            ridePlan.points={};ridePlan.index=1
            ridePlan.lastPlan=0
            driveDetour=nil
            driveLastMotionAt=os.clock()
        end
        startRidePath(horse,goalPoint,goalPart)
        while ridePlan.points[ridePlan.index] and
            raceLib.flat(ridePlan.points[ridePlan.index]-pos).Magnitude<math.clamp(
                11+math.abs(horse.CurrentSpeed or 0)*0.08,13,24) do
            ridePlan.index=ridePlan.index+1
        end
        if ridePlan.points[ridePlan.index] then
            return ridePlan.points[ridePlan.index],('Path %d/%d'):format(ridePlan.index,#ridePlan.points)
        end
        -- No path available: let multi-direction sensors pick a safe temporary heading.
        if ridePlan.planning then return nil,'Planning safe ride route' end
    end
    return goalPoint,ridePlan.status=='Idle' and 'Sensor navigation' or ridePlan.status
end
function raceLib.installRaceSteering(horse)
    if not horse or type(horse.GetPlayerInput)~='function' then return false end
    if driveHorse==horse and driveOverride and rawget(horse,'GetPlayerInput')==driveOverride then return true end
    raceLib.releaseRaceSteering()
    local original=horse.GetPlayerInput
    driveHorse=horse;driveOldInput=rawget(horse,'GetPlayerInput')
    driveOverride=function(self,...)
        if not alive or not ((settings.autoRace and settings.raceMode=='Ride') or settings.autoFarm)
            or self~=horse or not driveTarget then return original(self,...) end
        local pos=self.Root and self.Root.Position
        if not pos then return original(self,...) end
        local delta=raceLib.flat(driveTarget-pos)
        if delta.Magnitude<9 then return Vector3.zero end
        local direction,blocked=raceLib.chooseSteeringDirection(self,delta.Unit)
        local forward=CFrame.Angles(0,self.CurrentYaw or 0,0).LookVector
        local turn=-math.atan2(forward:Cross(direction).Y,forward:Dot(direction))
        local turnLimit=math.rad(math.max(22,(self.Stats and self.Stats.TurnSpeed) or 80))
        local steer=math.clamp(turn/turnLimit,-1,1)
        local speed=math.abs(self.CurrentSpeed or 0)
        local maxCruise=math.clamp(settings.rideCruiseSpeed or 65,20,130)
        local targetSpeed=maxCruise
        if math.abs(turn)>0.7 then targetSpeed=math.min(targetSpeed,34) end
        if math.abs(turn)>1.25 then targetSpeed=math.min(targetSpeed,20) end
        if delta.Magnitude<35 then targetSpeed=math.min(targetSpeed,26) end
        local throttle
        if blocked then
            throttle= speed>8 and -0.4 or 0
        elseif speed>targetSpeed+5 then
            throttle=-0.22
        elseif speed>targetSpeed then
            throttle=0
        else
            throttle=math.abs(turn)>1.4 and 0.25 or 1
        end
        return Vector3.new(steer,0,throttle)
    end
    rawset(horse,'GetPlayerInput',driveOverride)
    return true
end
