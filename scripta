local function updateAutomation()
    local horse=getHorse()
    local _,humanoid,root=getCharacter()
    updateStamina(horse)
    if settings.boostRefill and horse and os.clock()>nextBoost then
        nextBoost=os.clock()+0.7
        pcall(function() horse.Model:SetAttribute('DidBoost',false) end)
    end
    if settings.autoCall and horse and root and os.clock()>nextHorseCall then
        nextHorseCall=os.clock()+4
        local mounted=false
        local ok,m=pcall(function() return horse:IsMounted() end)
        if ok then mounted=m end
        if not mounted and horse.Root and (horse.Root.Position-root.Position).Magnitude>20 then
            safeCall(horse,'Call',root.Position)
        end
    end
    if settings.autoRace then
        if not routeStartAt then
            routeStartAt=os.clock()+settings.raceStartDelay
            routeLastProgress=tonumber(LocalPlayer:GetAttribute('CurrentCheckpoint'))
            lastRaceStepAt=0
        end
        if os.clock()<routeStartAt then
            raceStatus='Starting in '..math.ceil(routeStartAt-os.clock())..'s'
        else
            local waypoint,label=raceLib.getCheckpointTarget()
            local pos,activeHorse,mounted=raceLib.getActivePosition()
            local progress=tonumber(LocalPlayer:GetAttribute('CurrentCheckpoint'))
            if progress~=routeLastProgress then
                lastRaceStepAt=os.clock()+settings.raceWaypointDelay
                nextRaceTeleport=0
                localPlaneSide=nil
                routeLastProgress=progress
                raceLib.clearRidePlan()
            end
            if not waypoint then
                raceStatus=label or 'No race destination'
                raceLib.releaseRaceSteering()
            elseif not pos then
                raceStatus='Waiting for character'
                raceLib.releaseRaceSteering()
            elseif settings.raceMode=='Ride' then
                if not mounted then
                    raceLib.releaseRaceSteering()
                    raceStatus='Paused • mount your horse'
                    if settings.raceAutoCall and activeHorse and activeHorse.Root and os.clock()>nextHorseCall then
                        nextHorseCall=os.clock()+4
                        safeCall(activeHorse,'Call',pos)
                    end
                elseif os.clock()<lastRaceStepAt then
                    driveTarget=nil
                    raceStatus='Checkpoint confirmed • waypoint delay'
                else
                    local dest=waypoint.Position
                    if label=='Finish zone' then
                        dest=dest+Vector3.new(0,3,0)
                        if raceLib.flat(pos-dest).Magnitude<25 then
                            raceStatus='At finish zone • awaiting game completion'
                            raceLib.releaseRaceSteering()
                        else
                            local ridePoint,navStatus=raceLib.rideWaypoint(activeHorse,waypoint,dest)
                            if ridePoint then raceLib.movementToward(ridePoint) else driveTarget=nil end
                            raceStatus='Finish • '..tostring(navStatus)..' • '..math.floor(raceLib.flat(pos-dest).Magnitude)..' studs'
                        end
                    else
                        -- Checkpoint parts are very wide invisible vertical planes.
                        -- Approach their location in XZ, and use CurrentCheckpoint to confirm progress.
                        local ridePoint,navStatus=raceLib.rideWaypoint(activeHorse,waypoint,raceLib.getRideAimPoint(waypoint))
                        if ridePoint then raceLib.movementToward(ridePoint) else driveTarget=nil end
                        local localPos=waypoint.CFrame:PointToObjectSpace(pos)
                        local atPlane=(math.abs(localPos.Z)<30 and
                            math.abs(localPos.X)<=waypoint.Size.X/2+20 and
                            math.abs(localPos.Y)<=waypoint.Size.Y/2+30)
                        raceStatus=(atPlane and 'Crossing ' or 'Riding to ')..label..
                            ' • '..tostring(navStatus)..' • '..math.floor(raceLib.flat(pos-dest).Magnitude)..' studs'
                        if progress==nil and raceLib.passedCheckpointPlane(waypoint,pos) then
                            routeIndex=(routeIndex or 1)+1
                            if routeIndex>#getCheckpoints() then
                                routeIndex=nil
                                raceStatus='Checkpoint planes crossed; server progress unknown'
                            end
                            localPlaneSide=nil
                        end
                    end
                end
            elseif settings.raceMode=='Teleport' then
                raceLib.releaseRaceSteering()
                if os.clock()<lastRaceStepAt then
                    raceStatus='Checkpoint confirmed • waiting'
                elseif os.clock()>=nextRaceTeleport then
                    nextRaceTeleport=os.clock()+5
                    if label=='Finish zone' then
                        local ok,reason=raceLib.localTeleportTo(waypoint,Vector3.new(0,0,0))
                        raceStatus=ok and 'Finish position attempted (client only)' or reason
                    else
                        local checkpoints=getCheckpoints()
                        local previous=nil
                        for i,cp in ipairs(checkpoints) do
                            if cp==waypoint then previous=checkpoints[i-1];break end
                        end
                        local ok,reason=raceLib.nextCheckpointTeleport(waypoint,previous)
                        raceStatus=ok and ('Teleport attempt: '..label..' • await server') or reason
                    end
                else
                    raceStatus='Waiting for checkpoint confirmation; may be server-rejected'
                end
            end
        end
    else
        routeIndex=nil;routeStartAt=nil;routeLastProgress=nil
        nextRaceTeleport=0;routeFinishPending=false
        if ridePlan.goal then raceLib.clearRidePlan() end
        raceStatus='Idle'
        raceLib.releaseRaceSteering()
    end
    if settings.autoFarm or (settings.autoRace and settings.raceItemDetour) then
        local target,dist=closestItem()
        if target and dist then
            if target~=lastFarmTarget then
                lastFarmTarget=target;farmArrivedAt=nil
            end
            if dist>8 then
                farmArrivedAt=nil
                local p=getPart(target)
                if p then raceLib.movementToward(p.Position) end
            else
                if not farmArrivedAt then farmArrivedAt=os.clock() end
                if os.clock()-farmArrivedAt>=settings.farmHold and os.clock()>nextFarmAction then
                    nextFarmAction=os.clock()+1.5
                    tryPickup(target)
                    statusMessage('Interacting with '..target.Name)
                end
            end
        else
            lastFarmTarget=nil;farmArrivedAt=nil
        end
    else lastFarmTarget=nil;farmArrivedAt=nil end
end


