        else
            if chosen and (not selectedThreat or selectedThreat.part~=chosen.part) then
                diagPush('GUARD_TARGET',summary)
            end
            selectedThreat=chosen and {part=chosen.part,since=now} or nil
            lastGuardTargetReason=summary
        end
        combatDiag.lastThreatSnapshot=lastGuardTargetReason
    end
    if chosen then return chosen.part,chosen.distance,chosen.kind or 'Proximity' end
    return nil,math.huge,nil
end
-- Body-only lock. Select a target in the slower combat scan, but continuously turn
-- AFTER Roblox's standard character render update. Never change the camera.
local function releaseBodyLock()
    if bodyLock.humanoid and bodyLock.humanoid.Parent and bodyLock.originalAutoRotate~=nil then
        pcall(function() bodyLock.humanoid.AutoRotate=bodyLock.originalAutoRotate end)
    end
    bodyLock.humanoid=nil;bodyLock.originalAutoRotate=nil;bodyLock.target=nil
    bodyLock.lastRotation=nil;bodyLock.shiftLockDetected=false
    bodyLock.blockedReason='No target / disabled'
end
local function faceBodyToward(root,humanoid,target)
    if not settings.faceTarget or not settings.autoBlock or not target or not target.Parent or
        not humanoid or humanoid.Health<=0 or humanoid.Sit then
        releaseBodyLock();return
    end
    if bodyLock.humanoid~=humanoid then
        releaseBodyLock()
        bodyLock.humanoid=humanoid
        bodyLock.originalAutoRotate=humanoid.AutoRotate
    end
    bodyLock.target=target
    bodyLock.lastTargetAt=os.clock()
