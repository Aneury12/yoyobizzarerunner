local function startRequestedBlock(attack, why, minInterval)
    local now=os.clock()
    minInterval=minInterval or 0.27
    if not attack or attack.KeepBlocking or blockStartPending or now-lastBlockAction < minInterval then return false end
    lastBlockAction=now
    blockStartPending=true
    autoBlockOwned=true -- own this request from initiation, even before Block() yields
    blockRequestEpoch=blockRequestEpoch+1
    local thisEpoch=blockRequestEpoch
    blockAttempts=blockAttempts+1
    blockLastMode=settings.blockMode or 'Fast'
    blockLastAttemptReason=tostring(why or 'unknown')
    lastBlockError=nil
    diagPush('BLOCK','Request #'..blockAttempts..' ['..blockLastMode..'] reason='..blockLastAttemptReason,true)

    task.spawn(function()
        local ok, err=pcall(function() attack:Block() end)
        if thisEpoch~=blockRequestEpoch then return end
        blockStartPending=false
        autoBlockOwned=false
        if not ok then
            lastBlockError=tostring(err):sub(1,160)
            diagPush('ERROR','Block method: '..lastBlockError,true)
            statusMessage('Block method error: '..lastBlockError,true)
        elseif not attack.KeepBlocking and lastBlockActivatedAt<now then
            lastBlockError='Block returned without active hold (cooldown, action restriction, or server state)'
            diagPush('BLOCK',lastBlockError..' | '..diagRestrictions(diagLocalState()),true)
        end
    end)
    -- Validate the *in-progress* call, rather than waiting for it to return.
    task.delay(0.045,function()
        if not alive or thisEpoch~=blockRequestEpoch then return end
        blockStartPending=false
        if attack.KeepBlocking then
            autoBlockOwned=true
            lastBlockActivatedAt=os.clock()
            diagPush('BLOCK','Controller KeepBlocking became true; checking actual Blocking separately',true)
        else
            autoBlockOwned=false
            lastBlockError=lastBlockError or 'Block() did not enter hold state'
            diagPush('BLOCK',lastBlockError..' | '..diagRestrictions(diagLocalState()),true)
        end
    end)
    return true
end
local function updateBlock(runToken)
    guardTelemetry.phase='controller lookup'
    local attack=getController('AttackController')
    if runToken and runToken~=guardTelemetry.serial then return end
    if not attack then diagBlockDecision('NO_CONTROLLER','AttackController unavailable'); return end
    local now=os.clock()
    local movement=getController('MovementController')
    if runToken and runToken~=guardTelemetry.serial then return end
    local states=movement and movement.States
    guardTelemetry.phase='evaluating prerequisites' 
    if states and states.Aiming then
        -- Game cancels aiming upon Block(); do not force blocks while aiming.
        if autoBlockOwned then stopAutoBlock(attack) end
        releaseBodyLock()
        diagBlockDecision('AIMING','Block() would cancel revolver aiming')
        return
    end
    if manualBlockUntil>now then
        releaseBodyLock()
        diagBlockDecision('MANUAL_TEST','1.5-second test is running')
        if not attack.KeepBlocking then startRequestedBlock(attack,'Manual test',0.27) end
        return
    elseif manualBlockStarted then
        manualBlockStarted=false
        stopAutoBlock(attack)
        statusMessage('Block test ended; use Check block state for the result')
    end
    if not settings.autoBlock then
        diagBlockDecision('AUTO_BLOCK_OFF','Enable auto block to record automatic requests')
        if autoBlockOwned then stopAutoBlock(attack) end
        blockThreatUntil=0;counterReadyAt=0;lastThreatTarget=nil
        blockDetectedAt=0;blockDetectedTarget=nil
        releaseBodyLock()
        return
    end
    local character,humanoid,root=getCharacter()
    if not character or not root or not humanoid or humanoid.Health<=0 then
        diagBlockDecision('NO_CHARACTER','Character missing or eliminated')
        if autoBlockOwned then stopAutoBlock(attack) end
        releaseBodyLock()
        return
    end
    local mode=settings.blockMode or 'Fast'
    guardTelemetry.phase='attack scan'
    local enemy,distance,kind=closestCombatThreat(root,true,'guard')
    if runToken and runToken~=guardTelemetry.serial then return end
    local samples=combatDiag.blockSamples
    samples.total=samples.total+1
    if enemy then samples.qualified=samples.qualified+1 else samples.noTarget=samples.noTarget+1 end
    local projectile=settings.projectileBlock and closeProjectile(root) or nil
    local confirmed=enemy and (kind=='M1' or kind=='Skill')
    local threat=false
    if mode=='Legit' then
        -- Attack cues only. No passive block merely for standing near a player.
        threat=(confirmed~=nil and confirmed~=false) or projectile~=nil
    elseif mode=='Fast' then
        -- Early defensive reaction to confirmed cues or a nearby opponent.
        local closeFast=enemy~=nil and kind=='Proximity' and settings.proximityGuard
            and distance<=math.min(7,settings.blockRange*0.55)
            and isFacing(enemy,root.Position,0.25)
        threat=(enemy~=nil and confirmed) or closeFast or projectile~=nil
    else
        -- Blatant: proactive hold when any nearby opponent is present.
        threat=enemy~=nil or projectile~=nil
    end
    if threat then
        if blockDetectedTarget~=enemy or blockDetectedAt==0 then
            blockDetectedAt=now
            blockDetectedTarget=enemy
        end
        local hold=((kind=='Skill' or projectile~=nil) and settings.m1HoldWindowMs*1.5 or settings.m1HoldWindowMs)/1000
        if mode=='Fast' then hold=math.max(hold,0.40) end
        if mode=='Blatant' then hold=math.max(hold,0.65) end
        blockThreatUntil=math.max(blockThreatUntil,now+hold+settings.comboGraceMs/1000)
        lastBlockReason=projectile and 'Projectile' or (kind or 'Proximity')
        lastThreatTime=now
        if enemy then lastThreatTarget=enemy end
    else
        blockDetectedAt=0
        blockDetectedTarget=nil
    end

    guardTelemetry.phase='deciding block'
    local wantsBlock=now<blockThreatUntil
    local reaction=(mode=='Legit' and settings.legitReactionMs/1000)
        or (mode=='Fast' and settings.fastReactionMs/1000) or 0
    -- If the threat faded after detection, the hold window can continue.
    local reactionReady=blockDetectedAt==0 or now-blockDetectedAt>=reaction
    if wantsBlock and reactionReady then
        if not attack.KeepBlocking then
            local retryInterval=mode=='Legit' and 0.37 or (mode=='Fast' and 0.28 or 0.26)
            if startRequestedBlock(attack,lastBlockReason,retryInterval) then
                diagBlockDecision('REQUEST_SENT',lastBlockReason)
            else
                diagBlockDecision('REQUEST_SUPPRESSED',blockStartPending and 'request pending' or 'retry cooldown / controller hold')
            end
        else
            local _,active=readBlockState(attack)
            diagBlockDecision(active and 'ACTIVE_BLOCK' or 'HOLD_NOT_ACTIVE',
                active and 'MovementController confirms block' or 'Controller holds input but movement state is not blocking')
        end
    elseif wantsBlock then
        diagBlockDecision('REACTION_WAIT',('mode %s; delay %d ms'):format(mode,math.floor(reaction*1000+0.5)))
    else
        if enemy then
            diagBlockDecision('NO_ATTACK_CUE',('nearest qualified target %.1f studs | %s | mode %s'):format(distance,kind or 'no cue',mode))
        else
            diagBlockDecision('NO_QUALIFIED_TARGET','none detected inside block range / facing filter')
        end
        if autoBlockOwned then stopAutoBlock(attack) end
        lastThreatTarget=nil
    end

    local requested,actual=readBlockState(attack)
    if requested then samples.requesting=samples.requesting+1 end
    if actual then samples.active=samples.active+1;lastActualBlockAt=now end
    if lastBlockDecisionCode=='ACTIVE_BLOCK' and not actual then
        diagBlockDecision(requested and 'HOLD_NOT_ACTIVE' or 'BLOCK_RELEASED',
            'Client guard no longer active; '..diagRestrictions(diagLocalState()))
    end
    if requested and actual then
        if blockEngagedAt==0 then
            blockEngagedAt=now
            blockActivations=blockActivations+1
        end
    else
        blockEngagedAt=0
    end

    guardTelemetry.phase='counter eligibility'
    -- Counter only when a local BlockImpact reaction animation actually played.
    -- The character's regular Blocking state alone is never enough.
    if not settings.autoPunch then
        counterReadyAt=0
        counterReason='Counter disabled'
    elseif lastBlockImpact.sequence>lastBlockImpact.used and now-lastBlockImpact.at<0.9 then
        local candidate=lastBlockImpact.target
        local enemyPart=candidate and candidate.Parent and candidate or enemy
        local d=enemyPart and (enemyPart.Position-root.Position).Magnitude or math.huge
        local counterMode=settings.autoPunchMode or 'Legit'
        local delayTime=(counterMode=='Legit' and settings.legitBaseDelayMs/1000)
            or (counterMode=='Fast' and 0.055 or 0.01)
