local function reconcileMarks(kind,found,color,labelfn)
    local present={}
    for _,obj in ipairs(found) do
        if obj and obj.Parent then
            present[obj]=true
            makeMarker(kind,obj,color,labelfn and labelfn(obj) or obj.Name)
        end
    end
    for obj,mark in pairs(marks[kind]) do
        if not present[obj] or not obj.Parent then
            pcall(function() mark:Destroy() end)
            marks[kind][obj]=nil
        end
    end
end
local function updateESP()
    if settings.horseESP then
        local horses,seen={},{}
        for _,horse in ipairs(CollectionService:GetTagged('Horse')) do
            if not seen[horse] then table.insert(horses,horse);seen[horse]=true end
        end
        local mounts=workspace:FindFirstChild('Mounts')
        if mounts then
            for _,model in ipairs(mounts:GetChildren()) do
                if model:IsA('Model') and model:FindFirstChild('RootPart') and not seen[model] then
                    table.insert(horses,model);seen[model]=true
                end
            end
        end
        reconcileMarks('horses',horses,colors.bright)
    else clearMarks('horses') end
    if settings.itemESP then
        local items,folder={},getSpawnedFolder()
        if folder then for _,obj in ipairs(folder:GetChildren()) do table.insert(items,obj) end end
        reconcileMarks('items',items,colors.green)
    else clearMarks('items') end
    if settings.hazardESP then
        local hazards,seen={},{}
        for _,tag in ipairs({'Hazard','Trap','Chollas'}) do
            for _,obj in ipairs(CollectionService:GetTagged(tag)) do
                if not seen[obj] then seen[obj]=true;table.insert(hazards,obj) end
            end
        end
        local events=workspace:FindFirstChild('MapEvents')
        if events then
            for _,obj in ipairs(events:GetChildren()) do
                if (obj:IsA('BasePart') or obj:IsA('Model')) and
                    (obj.Name:lower():find('hazard') or obj.Name:lower():find('trap') or obj.Name:lower():find('cholla')) and not seen[obj] then
                    seen[obj]=true;table.insert(hazards,obj)
                end
            end
        end
        reconcileMarks('hazards',hazards,colors.red)
    else clearMarks('hazards') end
    if settings.checkpointMarker then
        reconcileMarks('checkpoints',getCheckpoints(),colors.accent,function(o) return 'CP '..o.Name end)
    else clearMarks('checkpoints') end
end
