local function doNextCheckpoint()
    local part,name = raceLib.getCheckpointTarget()
    if not part then info(name or 'Checkpoint unavailable',true);return end
    if name=='Finish zone' then
        local ok,message=raceLib.localTeleportTo(part,Vector3.zero)
        info(message,not ok);return
    end
    local previous
    for i,p in ipairs(getCheckpoints()) do
        if p==part then previous=getCheckpoints()[i-1];break end
    end
    local ok,message=raceLib.nextCheckpointTeleport(part,previous)
    info(message,not ok)
end
