local function diagRecordAnimation(character, track, source)
    if not (settings.diagCapture or settings.autoBlock) or not track or not track.Animation then return end
    local anim=track.Animation
    local id=diagAnimationId(track)
    local owner=character and character.Name or 'Unknown'
    local name=diagShort(anim.Name or 'unnamed',36)
    local category,label,confidence=classifiedAnimation(id,anim.Name)
    local key=owner..'/'..id
    local now=os.clock()
    local last=combatDiag.seenAnimations[key]
    -- Always update the per-character cue, even if the diagnostic line is deduplicated.
    if character and (category=='M1' or category=='Skill') then
        combatDiag.cues[character]={at=now,kind=category,id=id,label=label,confidence=confidence}
        combatDiag.latestCue={at=now,owner=owner,name=label,id=id,kind=category}
    end
    if not settings.diagCapture or (last and now-last.at<0.28) then return end
    if not last then combatDiag.uniqueCount=combatDiag.uniqueCount+1 end
    combatDiag.seenAnimations[key]={at=now,count=(last and last.count or 0)+1,name=name,owner=owner,id=id}
    combatDiag.totalAnimations=combatDiag.totalAnimations+1
    combatDiag.lastMove={name=name,owner=owner,id=id,time=now,kind=category,confidence=confidence,label=label}
    if confidence=='Known' then combatDiag.autoKnown=combatDiag.autoKnown+1
    elseif confidence=='Likely' then combatDiag.autoLikely=combatDiag.autoLikely+1
    else combatDiag.unknown=combatDiag.unknown+1 end
    diagPush('ANIM',owner..' | '..id..' | '..category..' ('..confidence..') | '..label)
end
local function diagUnwatch(character)
    local w=combatDiag.watchers[character]
    if not w then return end
    for _,c in ipairs(w.connections) do pcall(function() c:Disconnect() end) end
    combatDiag.watchers[character]=nil
end
local function diagWatch(character)
    if combatDiag.watchers[character] then return end
    local humanoid=character and character:FindFirstChildOfClass('Humanoid')
    local animator=humanoid and humanoid:FindFirstChildOfClass('Animator')
    if not animator then return end
    local w={connections={},humanoid=humanoid,animator=animator,flags={}}
    combatDiag.watchers[character]=w
    table.insert(w.connections, animator.AnimationPlayed:Connect(function(track)
        if alive then diagRecordAnimation(character,track,'event') end
    end))
    -- Subscribe to short-lived replicated attack flags as well as animations.
    -- Polling alone can miss flags that flip on and off between updates.
    local function flagChanged(flag)
        if not alive or not settings.diagCapture then return end
        local on=isActiveValue(character,flag) or isActiveValue(humanoid,flag)
        if on ~= w.flags[flag] then
            w.flags[flag]=on
            if on then
                diagPush('STATE',character.Name..' '..flag..' = true')
                combatDiag.latestCue={at=os.clock(),owner=character.Name,name=flag,id='attribute',kind=flag}
            end
        end
    end
    for _,flag in ipairs(attackStateKeys) do
        for _,obj in ipairs({character,humanoid}) do
            table.insert(w.connections,obj:GetAttributeChangedSignal(flag):Connect(function() flagChanged(flag) end))
            local bool=obj:FindFirstChild(flag)
            if bool and bool:IsA('BoolValue') then
                table.insert(w.connections,bool:GetPropertyChangedSignal('Value'):Connect(function() flagChanged(flag) end))
            end
        end
    end
    -- Also record tracks that were already active when we approached the target.
    local ok,tracks=pcall(function() return animator:GetPlayingAnimationTracks() end)
    if ok and tracks then for _,t in ipairs(tracks) do diagRecordAnimation(character,t,'snapshot') end end
end
local function diagFindTargets()
    local _,_,root=getCharacter()
    if not root then return {} end
    local nearby={}
    local function offer(char)
        if not char or nearby[char] or char==LocalPlayer.Character then return end
        local hum=char:FindFirstChildOfClass('Humanoid')
        local part=char:FindFirstChild('HumanoidRootPart')
        if hum and part and hum.Health>0 and (part.Position-root.Position).Magnitude <= math.max(settings.diagRange,settings.blockRange+15,settings.blatantRange+15) then nearby[char]=true end
    end
    for _,p in ipairs(Players:GetPlayers()) do if p~=LocalPlayer then offer(p.Character) end end
    if settings.diagIncludeNPCs then
        local ok,parts=pcall(function() return workspace:GetPartBoundsInRadius(root.Position, settings.diagRange) end)
        if ok then
            local found=0
            for _,part in ipairs(parts) do
                local model=part:FindFirstAncestorOfClass('Model')
                if model and model:FindFirstChildOfClass('Humanoid') and not Players:GetPlayerFromCharacter(model) then
                    offer(model); found=found+1
                    if found>=30 then break end
                end
            end
        end
    end
    return nearby
end
local function diagPollTargets()
    local now=os.clock()
    if now-combatDiag.lastWatcherScan<0.18 then return end
    combatDiag.lastWatcherScan=now
    local nearby=diagFindTargets()
    for char in pairs(combatDiag.watchers) do if not nearby[char] or not char.Parent then diagUnwatch(char) end end
    local watched=0
    for char in pairs(nearby) do
        if watched>=24 then break end
        diagWatch(char)
        local w=combatDiag.watchers[char]
        if w then
            watched=watched+1
            for _,flag in ipairs(attackStateKeys) do
                local on=isActiveValue(char,flag) or isActiveValue(w.humanoid,flag)
                if on and not w.flags[flag] then
                    diagPush('STATE',char.Name..' '..flag..' = true')
                    local typ=(flag=='UsingSkill' or flag=='SkillActive' or flag=='Barrage') and 'Skill' or 'M1'
                    combatDiag.cues[char]={at=now,kind=typ,id='state',label=flag,confidence='Likely'}
                    combatDiag.latestCue={at=now,owner=char.Name,name=flag,id='attribute',kind=typ}
                end
                w.flags[flag]=on
            end
        end
    end
end
