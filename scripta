local function applyScale()
    local density = (state.density == 'Dense' and 0.94) or (state.density == 'Roomy' and 1.04) or 1
    local viewport = Camera and Camera.ViewportSize or Vector2.new(1200, 800)
    local fit = math.clamp(math.min((viewport.X-36)/780, (viewport.Y-48)/540), 0.60, 1)
    uiScale.Scale = fit * (state.scale / 100) * (state.compact and 0.94 or 1) * density
end

track(Camera:GetPropertyChangedSignal('ViewportSize'):Connect(applyScale))
local function set(spec, val, silent)
    state[spec.id] = val
    if spec.id == 'hue' or spec.id == 'theme' then
        buildTheme()
        for _, f in ipairs(themed) do pcall(f) end
    end
    applyScale()
    updateAurora()
    if spec.onChange then
        local ok, err = pcall(spec.onChange, val)
        if not ok then status('Error: ' .. tostring(err)); return end
    end
    if not silent then status((spec.label or spec.id) .. ' set to ' .. fmt(spec, val)) end
end

