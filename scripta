function raceLib.groundPositionNear(part, from, directionOffset)
    local side=(directionOffset or Vector3.zero)
    local candidate=part.Position+side
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    local exclude={}
    if LocalPlayer.Character then table.insert(exclude,LocalPlayer.Character) end
    local horse=getHorse()
    if horse and horse.Model then table.insert(exclude,horse.Model) end
    table.insert(exclude,part)
    params.FilterDescendantsInstances=exclude
    params.RespectCanCollide=true
    local ray=workspace:Raycast(candidate+Vector3.new(0,part.Size.Y/2+90,0),
        Vector3.new(0,-math.max(800,part.Size.Y+250),0),params)
    if not ray or ray.Normal.Y<0.5 then return nil end
    return Vector3.new(candidate.X,ray.Position.Y+5,candidate.Z)
end
function raceLib.localTeleportTo(part, offset)
    if not part then return false,'Destination unavailable' end
    local destination=raceLib.groundPositionNear(part,nil,offset)
    if not destination then return false,'No safe ground at destination' end
    local pos,horse,mounted=raceLib.getActivePosition()
    if not pos then return false,'Character unavailable' end
    local forward=raceLib.flat(part.CFrame.LookVector)
    if forward.Magnitude<0.1 then forward=Vector3.new(0,0,-1) end
    local cf=CFrame.lookAt(destination,destination+forward.Unit)
    local ok,err=pcall(function()
        if mounted and horse and horse.Model then
            horse.Model:PivotTo(cf)
            if horse.AlignPosition then horse.AlignPosition.Position=destination end
            if horse.AlignOrientation then horse.AlignOrientation.CFrame=cf end
            horse.CurrentYaw=select(2,cf:ToEulerAnglesYXZ())
            horse.Root.AssemblyLinearVelocity=Vector3.zero
        else
            local character=LocalPlayer.Character
            if character then character:PivotTo(cf) end
        end
    end)
    if not ok then return false,tostring(err) end
    return true,'Client-side move requested; awaiting server confirmation'
end
function raceLib.getCheckpointTarget()
    local checkpoints=getCheckpoints()
    if #checkpoints==0 then return nil,'No checkpoints loaded' end
    local progress=tonumber(LocalPlayer:GetAttribute('CurrentCheckpoint'))
    if progress~=nil then
        if progress>=tonumber(checkpoints[#checkpoints].Name) then
            return raceLib.getFinishPart(),'Finish zone'
        end
        local wanted=tostring(math.floor(progress)+1)
        for i,cp in ipairs(checkpoints) do
            if cp.Name==wanted then routeIndex=i;return cp,'Checkpoint '..wanted end
        end
        return nil,'Checkpoint '..wanted..' unavailable'
    end
    if not routeIndex then
        local pos=raceLib.getActivePosition()
        local bestIndex,bestDist=1,math.huge
        if pos then
            for i,cp in ipairs(checkpoints) do
                local distance=raceLib.flat(cp.Position-pos).Magnitude
                if distance<bestDist then bestIndex,bestDist=i,distance end
            end
        end
        routeIndex=math.min(bestIndex+1,#checkpoints)
    end
    return checkpoints[routeIndex],'Checkpoint '..checkpoints[routeIndex].Name..' (unconfirmed)'
end
function raceLib.getRideAimPoint(part)
    local previous=nil
    local cp=getCheckpoints()
    for i,p in ipairs(cp) do
        if p==part then previous=cp[i-1];break end
    end
    local heading=previous and Vector3.new(part.Position.X-previous.Position.X,0,part.Position.Z-previous.Position.Z)
        or Vector3.new(part.Position.X,0,part.Position.Z)
    local normal=Vector3.new(part.CFrame.LookVector.X,0,part.CFrame.LookVector.Z)
    if normal.Magnitude<0.1 then return part.Position end
    if heading.Magnitude>0.1 and heading:Dot(normal)<0 then normal=-normal end
    return part.Position+normal.Unit*70
end
function raceLib.passedCheckpointPlane(part, pos)
    if not pos or not part then return false end
    local localPos=part.CFrame:PointToObjectSpace(pos)
    local inside=math.abs(localPos.X)<=part.Size.X/2+15 and
        math.abs(localPos.Y)<=part.Size.Y/2+25
    local previous=localPlaneSide
    localPlaneSide=localPos.Z
    return inside and previous~=nil and previous*localPos.Z<0 and math.abs(previous)<140
end
function raceLib.nextCheckpointTeleport(part, previous)
    local normal=part.CFrame.LookVector
    local travel=(previous and raceLib.flat(part.Position-previous.Position)) or raceLib.flat(part.Position-(raceLib.getActivePosition() or part.Position))
    local sign=(travel.Magnitude>0.1 and travel:Dot(raceLib.flat(normal))>=0) and 1 or -1
    local before=-normal*sign*22
    local after=normal*sign*22
    local ok,reason=raceLib.localTeleportTo(part,before)
    if not ok then return false,reason end
    task.delay(0.35,function()
        if alive then raceLib.localTeleportTo(part,after) end
    end)
    return true,'Crossing '..part.Name..' locally; checking checkpoint progress'
end
local function tryPickup(item)
    if not item or not item.Parent then return end
