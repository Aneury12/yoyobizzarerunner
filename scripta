           name:find('swing',1,true) or name:match('m[1-6]') then return 'M1',animName,'Likely' end
        if name:find('blockhit',1,true) or name:find('blockreact',1,true) then
            return 'BlockImpact',animName,'Likely' end
        for _,term in ipairs({'idle','walk','run','jump','dash','stun','blocking'}) do
            if name:find(term,1,true) then
                return (term=='stun' and 'Stun' or term=='blocking' and 'BlockHold' or 'Movement'),animName,'Likely'
            end
        end
    end
    return 'Unknown','Unclassified','Unknown'
end
local function diagClassForAnimation(track)
