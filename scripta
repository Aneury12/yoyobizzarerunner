        ScrollBarThickness=0, AutomaticCanvasSize=Enum.AutomaticSize.None, CanvasSize=UDim2.new(),
        ScrollingEnabled=false, ScrollingDirection=Enum.ScrollingDirection.Y, ElasticBehavior=Enum.ElasticBehavior.Never,
        Visible=true})
    -- The unnecessary auto-canvas padding caused empty pages to bounce/scroll.
    skin(function() page.ScrollBarImageColor3 = T.accent end)
    local layout=list(page,12)
    pad(page,16,14,16,14)
    local scheduled=false
    local function refreshScroll()
        scheduled=false
        if not alive or not page.Parent then return end
        local visibleHeight=page.AbsoluteWindowSize.Y
        if visibleHeight<=0 then visibleHeight=page.AbsoluteSize.Y end
        if visibleHeight<=0 then return end
        local wanted=math.ceil(layout.AbsoluteContentSize.Y + 28)
        local canScroll=wanted>visibleHeight+6
        local canvasHeight=canScroll and wanted or 0
        if page.CanvasSize.Y.Offset~=canvasHeight then page.CanvasSize=UDim2.fromOffset(0,canvasHeight) end
        if page.ScrollingEnabled~=canScroll then page.ScrollingEnabled=canScroll end
        local scrollbar=canScroll and 3 or 0
        if page.ScrollBarThickness~=scrollbar then page.ScrollBarThickness=scrollbar end
        if not canScroll and page.CanvasPosition.Y~=0 then page.CanvasPosition=Vector2.new(0,0) end
    end
    local function queueScroll()
        if scheduled then return end
        scheduled=true
        task.defer(refreshScroll)
    end
    track(layout:GetPropertyChangedSignal('AbsoluteContentSize'):Connect(queueScroll))
    track(page:GetPropertyChangedSignal('AbsoluteSize'):Connect(queueScroll))
    scrollRefreshers[name]=queueScroll
