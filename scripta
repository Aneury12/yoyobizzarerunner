-- The revolver obtains its shot CFrame from PredictionController.Weapons:GetOrigin.
-- This local hook adjusts that CFrame *without moving the player's camera*.
-- It cannot override server-side checks and may not work in every session.
local function findAimTarget(cameraCF,maxRange)
    -- This function is called from per-frame revolver aiming updates.
    -- Cache briefly to avoid enumerating all rigs at display refresh rates.
    local now=os.clock()
    if now-lastAimScanAt<0.07 then
        return cachedAimPart and cachedAimPart.Parent and cachedAimPart or nil
    end
    lastAimScanAt=now
    cachedAimPart=nil
    local camera=workspace.CurrentCamera
    if not camera then return nil end
    local rigs=workspace:FindFirstChild('Rigs')
    if not rigs then return nil end
    local center=camera.ViewportSize*0.5
    local origin=cameraCF.Position
    local best,bestRadius=nil,settings.aimRadius
    local character=LocalPlayer.Character
    local exclusions={}
    if character then table.insert(exclusions,character) end
    local vfx=workspace:FindFirstChild('VFX')
    if vfx then table.insert(exclusions,vfx) end
    local mounts=workspace:FindFirstChild('Mounts')
    if mounts then table.insert(exclusions,mounts) end
    local rayParams=RaycastParams.new()
    rayParams.FilterType=Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances=exclusions
    rayParams.IgnoreWater=true
    local maxDist=math.min(maxRange or settings.aimMaxRange,settings.aimMaxRange)
    for _,rig in ipairs(rigs:GetChildren()) do
        if rig:IsA('Model') and rig~=character and not rig:GetAttribute('FinishPosition') then
            local who=Players:GetPlayerFromCharacter(rig)
            local allowed=(who~=nil and settings.aimPlayers) or (who==nil and settings.aimNPCs)
            if who==LocalPlayer then allowed=false end
            if who and who~=LocalPlayer and LocalPlayer.Team and who.Team==LocalPlayer.Team
                and not LocalPlayer.Neutral and not who.Neutral then allowed=false end
            if allowed then
                local hum=rig:FindFirstChildOfClass('Humanoid')
                local part
                if settings.aimHitPart=='Head' then
                    part=rig:FindFirstChild('Head')
                elseif settings.aimHitPart=='Root' then
                    part=rig:FindFirstChild('HumanoidRootPart')
                else
                    part=rig:FindFirstChild('UpperTorso') or rig:FindFirstChild('Torso')
                end
                part=part or rig:FindFirstChild('UpperTorso') or rig:FindFirstChild('Torso')
                    or rig:FindFirstChild('HumanoidRootPart')
                if hum and hum.Health>0 and part and part:IsA('BasePart') then
                    local diff=part.Position-origin
                    if diff.Magnitude>1 and diff.Magnitude<=maxDist then
                        local screen,onScreen=camera:WorldToViewportPoint(part.Position)
                        if onScreen and screen.Z>0 then
                            local radius=(Vector2.new(screen.X,screen.Y)-center).Magnitude
                            if radius<=bestRadius then
                                local visible=true
                                if settings.aimVisibility then
                                    local hit=workspace:Raycast(origin,diff,rayParams)
                                    visible=not hit or hit.Instance:IsDescendantOf(rig)
                                end
                                if visible then best=part;bestRadius=radius end
                            end
                        end
                    end
                end
            end
        end
    end
    cachedAimPart=best
    return best
end

