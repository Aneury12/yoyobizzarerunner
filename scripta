local function buildTab(name, cards)
    local page = newPage(name)
    pages[name] = page
    addTabButton(name)
    local cols = newColumns(page)
    for idx, c in ipairs(cards) do
        local _, inner = cardShell(cols[(idx - 1) % 2 + 1], true)
        local t = label(inner, c.card, 14, Enum.Font.GothamBold, 'fg'); t.Size = UDim2.new(1, 0, 0, 22)
        if c.hint then
            local h = label(inner, c.hint, 11, Enum.Font.Gotham, 'mute'); h.Size = UDim2.new(1, 0, 0, 18)
        end
        for _, spec in ipairs(c.items) do
            if spec.id then specIndex[spec.id] = spec end
            if spec.default ~= nil then
                defaults[spec.id] = spec.default
                if state[spec.id] == nil then state[spec.id] = spec.default end
            end
            local build = builders[spec.type]
            if build then build(inner, spec, name, c.card) end
        end
    end
end

