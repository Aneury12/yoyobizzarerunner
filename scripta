        if originals.aim then restoreSilentAim() end
        return
    end
    if originals.aim then return end
    local controller=getController('PredictionController')
    local weapons=controller and controller.Weapons
    if not weapons or type(weapons.GetOrigin)~='function' then
        silentAimInstallError='PredictionController.Weapons:GetOrigin not available'
        return
    end
    local original=weapons.GetOrigin
    local wrapped=function(self,weaponName,character,cameraCF,range)
        local origin=original(self,weaponName,character,cameraCF,range)
        if not alive or not settings.silentAim or weaponName~='Revolver'
            or character~=LocalPlayer.Character or typeof(origin)~='CFrame' then
            return origin
        end
        local sidearm=getController('SidearmController')
        local movement=getController('MovementController')
        local isAiming=movement and movement.States and movement.States.Aiming
        if not isAiming or not sidearm then return origin end
        local ok,currentSidearm=pcall(function() return sidearm:GetCurrentSidearm() end)
        if not ok or currentSidearm~='Revolver' then return origin end
        local okTarget,part=pcall(findAimTarget,cameraCF,range)
        if not okTarget or not part then
            currentSilentTargetName='none'
            return origin
        end
        local offset=part.Position-origin.Position
        if offset.Magnitude>1 then
            currentSilentTargetName=part.Parent.Name
            silentAimLastTargetAt=os.clock()
            return CFrame.lookAt(origin.Position,part.Position)
        end
        return origin
    end
    local ok,err=pcall(function() weapons.GetOrigin=wrapped end)
    if ok then
        originals.aim={weapons=weapons,original=original,wrapped=wrapped}
        silentAimInstallError=nil
        statusMessage('Revolver target correction installed (client-side only)')
    else
        silentAimInstallError=tostring(err):sub(1,140)
        statusMessage('Revolver hook unavailable: '..silentAimInstallError,true)
    end
end

local function restorePCAimAssist()
