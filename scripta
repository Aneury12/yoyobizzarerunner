            lastBlockImpact.used=lastBlockImpact.sequence
            nextCounterAllowed=now+cooldown
            counterReadyAt=0
            faceBodyToward(root,humanoid,enemyPart)
            stopAutoBlock(attack)
            blockThreatUntil=0
            counterReason='Counter requested after '..lastBlockImpact.id..' -> '..(enemyPart.Parent and enemyPart.Parent.Name or 'unknown')
            diagPush('COUNTER',counterReason,true)
            task.spawn(function()
                task.wait(0.07)
                if not alive or not settings.autoPunch or not settings.autoBlock then return end
                local s=getController('MovementController')
                if s and s.States and (s.States.Stunned or s.States.RidingHorse or s.States.Aiming) then return end
