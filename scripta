    corner(bar, 3)
    local fill = make('Frame', { Parent = bar, Size = UDim2.fromScale(0, 1), BorderSizePixel = 0 })
    corner(fill, 3)
    local knob = make('Frame', { Parent = bar, Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0 })
    corner(knob, 7); local knobStroke = make('UIStroke', { Parent = knob, Thickness = 2 })
    local value = label(region, '', 11, Enum.Font.Code, 'mute')
    value.Position = UDim2.new(1, -51, 0, 0); value.Size = UDim2.fromOffset(51, 24); value.TextXAlignment = Enum.TextXAlignment.Right
    local hit = make('TextButton', { Parent = region, BackgroundTransparency = 1, Text = '', Size = UDim2.new(1, -57, 0, 24) })
    local function paint()
        local pct = math.clamp((state[spec.id] - spec.min) / (spec.max - spec.min), 0, 1)
        fill.Size = UDim2.fromScale(pct, 1)
        knob.Position = UDim2.new(pct, 0, 0.5, 0)
        value.Text = fmt(spec, state[spec.id])
        value.TextColor3 = T.accent
        bar.BackgroundColor3 = T.control; fill.BackgroundColor3 = T.accent
        knob.BackgroundColor3 = T.fg; knobStroke.Color = T.accent
    end
    skin(paint)
    refreshers[#refreshers + 1] = paint
    local function atX(px)
        local pct = math.clamp((px - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
        local raw = spec.min + (spec.max - spec.min) * pct
        local v = math.floor(raw / spec.step + 0.5) * spec.step
        v = math.clamp(math.floor(v * 1000 + 0.5) / 1000, spec.min, spec.max)
        if v ~= state[spec.id] then set(spec, v); paint() end
    end
    track(hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = atX; atX(input.Position.X)
        end
    end))
end
track(UserInputService.InputChanged:Connect(function(input)
    if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
