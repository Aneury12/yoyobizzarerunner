local function itemMatches(item)
    local wanted=tostring(settings.itemChooser or 'Any'):lower():gsub('^%s+',''):gsub('%s+$','')
    if type(settings.itemList)=='string' and settings.itemList~='' then
        local searchable=item.Name:lower():gsub('[%s_%-]','')
        for key in string.gmatch(settings.itemList:lower(),'[^,]+') do
            local token=key:gsub('[%s_%-]','')
            if token~='' and searchable:find(token,1,true) then return true end
        end
        return false
    end
    if wanted=='' or wanted=='any' or wanted=='all' then return true end
    local name=string.lower(item.Name)
    if wanted=='rokakaka' then wanted='rokakaka'
    elseif wanted=='shiny arrow' then wanted='shinyarrow'
    elseif wanted=='corpse part' then
        return name:find('corpse',1,true)~=nil or name:find('saint',1,true)~=nil
    elseif wanted=='other' then
        local common=(name:find('rokakaka',1,true) or name:find('arrow',1,true) or name:find('corpse',1,true)
            or name:find('saint',1,true))
        if not common then return true end
        return false
    end
    name=name:gsub('[%s_%-]','')
    for _,a in ipairs({'Item','ItemId','ItemType','Type'}) do
        local value=item:GetAttribute(a)
        if type(value)=='string' then name=name..' '..string.lower(value):gsub('[%s_%-]','') end
    end
    return string.find(name,wanted,1,true)~=nil
end
local function closestItem()
    local _,_,root=getCharacter()
    local f=getSpawnedFolder()
    if not f or not root then return nil end
    local nearest,dist=nil,settings.farmRange
    for _,obj in ipairs(f:GetChildren()) do
        local p=getPart(obj)
        if p and itemMatches(obj) then
            local d=(p.Position-root.Position).Magnitude
            if d<dist then nearest=obj;dist=d end
        end
    end
    return nearest,dist
end
