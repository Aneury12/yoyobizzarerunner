local function diagMonitorBlockState()
    if not settings.diagCapture and not combatDiag.test then return end
    local s=diagLocalState()
    local previous=combatDiag.lastState
    if previous then
        if s.requested~=previous.requested then
            if not s.requested then
                guardTelemetry.releasedAt=os.clock()
                guardTelemetry.lastReleaseReason=(lastBlockDecisionCode or 'unknown')
                guardTelemetry.lastReleaseState=diagRestrictions(s)
            else guardTelemetry.heldAt=os.clock() end
            diagPush('BLOCK','KeepBlocking -> '..tostring(s.requested)..
                ' | mode='..tostring(settings.blockMode)..' | decision='..tostring(lastBlockDecision)..
                ' | restrictions='..diagRestrictions(s),true)
        end
        if s.blocking~=previous.blocking then
            diagPush('BLOCK','Movement.States.Blocking -> '..tostring(s.blocking)..
                ' | requested='..tostring(s.requested)..' | restrictions='..diagRestrictions(s),true)
        end
        if s.attacking~=previous.attacking then diagPush('SELF','Attacking -> '..tostring(s.attacking)) end
        if s.stunned~=previous.stunned then diagPush('SELF','Stunned -> '..tostring(s.stunned)) end
    end
    combatDiag.lastState=s
    if combatDiag.test then
        local t=combatDiag.test
        t.samples=t.samples+1
        if s.requested then t.requestedSamples=t.requestedSamples+1 end
        if s.blocking then t.activeSamples=t.activeSamples+1 end
        if s.requested and not s.blocking then t.holdWithoutBlocking=t.holdWithoutBlocking+1 end
        for _,reason in ipairs({'attacking','keepAttacking','aiming','stunned','ragdoll','dashing','inAbility','riding'}) do
            if s[reason] then t.reasons[reason]=true end
        end
    end
    if previous and previous.health>=0 and s.health>=0 and s.health<previous.health-0.01 then
        local damage=previous.health-s.health
        combatDiag.totalDamageEvents=combatDiag.totalDamageEvents+1
        combatDiag.lastDamage=os.clock()
        local cue=combatDiag.latestCue
        local association=cue and os.clock()-cue.at<1.25 and (' | recent cue: '..cue.owner..'/'..cue.name) or ''
        -- Capture distance at impact, not when the report is exported later.
        local _,_,ourRoot=getCharacter()
        local nearName,nearDist='none',math.huge
        if ourRoot then
            for _,other in ipairs(Players:GetPlayers()) do
                if other ~= LocalPlayer and other.Character then
                    local r=other.Character:FindFirstChild('HumanoidRootPart')
                    local h=other.Character:FindFirstChildOfClass('Humanoid')
                    if r and h and h.Health>0 then
                        local d=(r.Position-ourRoot.Position).Magnitude
                        if d<nearDist then nearName,nearDist=other.Name,d end
                    end
                end
            end
        end
        local nearLabel=nearDist<math.huge and string.format('%s %.1f studs',nearName,nearDist) or 'unknown'
        local decisionAge=lastBlockDecisionAt>0 and (os.clock()-lastBlockDecisionAt) or -1
        local hitDetail=string.format('HP -%.1f | blocking=%s | hold=%s | nearest=%s | mode=%s | decision=%s (%.2fs old) | lock=%s yawErr=%.1f | release=%s%s',
            damage,tostring(s.blocking),tostring(s.requested),nearLabel,tostring(settings.blockMode),
            tostring(lastBlockDecision),decisionAge,
            bodyLock.target and bodyLock.target.Parent and bodyLock.target.Parent.Name or 'none',
            bodyLock.yawError,guardTelemetry.lastReleaseReason,association)
        diagPush('HIT',hitDetail,true)
        table.insert(combatDiag.hitContexts,1,string.format('[+%.2fs] %s',os.clock()-combatDiag.startAt,hitDetail))
        while #combatDiag.hitContexts>24 do table.remove(combatDiag.hitContexts) end
        if combatDiag.test then combatDiag.test.damage=combatDiag.test.damage+damage end
    end
end
