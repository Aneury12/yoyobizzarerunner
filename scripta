    if not chosen and (settings.blockMode=='Blatant' or settings.proximityGuard) then chosen=fallback[1] end
    local prior=choosingBody and selectedVisualThreat or selectedThreat
    if chosen and prior and prior.part~=chosen.part and now-prior.since<0.35 then
        -- Only hold a prior target when it is still attacking and essentially tied in distance.
        for _,e in ipairs(attackers) do
