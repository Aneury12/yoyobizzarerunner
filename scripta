local function addSlider(inner, spec, tabName, cardName)
    local row = rowBase(inner, spec, tabName, cardName)
    local region = make('Frame', { Parent = row, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, 0, 1, -6), Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1 })
