----------------------------------------------------------------------
local navSerial = 0
local activePageTween = nil
local function showPage(name)
    local target=pageGroups[name]
    if not target then return end
    navSerial=navSerial+1
    if activePageTween then activePageTween:Cancel();activePageTween=nil end
    for n,g in pairs(pageGroups) do
        if n~=name then
            g.Visible=false
            g.GroupTransparency=1
            g.Position=UDim2.fromOffset(0,0)
        end
    end
    target.Visible=true
    local selectedPage=pages[name]
    if selectedPage and not selectedPage.ScrollingEnabled then selectedPage.CanvasPosition=Vector2.zero end
    target.Position=state.reduceMotion and UDim2.fromOffset(0,0) or UDim2.fromOffset(5,0)
    target.GroupTransparency=state.reduceMotion and 0 or 1
    if not state.reduceMotion then
        activePageTween=tween(target,0.14,{GroupTransparency=0,Position=UDim2.fromOffset(0,0)})
    end
    if scrollRefreshers[name] then task.defer(scrollRefreshers[name]) end
end
function goTab(name)
    if activeTab ~= name or not pageGroups[name].Visible then
        activeTab = name
        showPage(name)
    end
    for i, n in ipairs(tabOrder) do
        local on = (n == name)
        tabButtons[n].TextColor3 = on and T.fg or T.mute
        if on then
            local x = 12 + (i - 1) * (TAB_W + TAB_GAP) + 12
            if state.reduceMotion then underline.Position = UDim2.fromOffset(x, 37)
