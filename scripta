local function observedAttackKind(character, humanoid)
    local now=os.clock()
    local cue=combatDiag.cues[character]
    if cue and now-cue.at<(cue.kind=='Skill' and 1.05 or 0.82) then return cue.kind, cue.label end
    for _,key in ipairs(attackStateKeys) do
        if isActiveValue(character,key) or isActiveValue(humanoid,key) then
            return ((key=='UsingSkill' or key=='SkillActive' or key=='Barrage') and 'Skill' or 'M1'),key
        end
    end
    local animator=humanoid:FindFirstChildOfClass('Animator')
    if not animator then return nil,nil end
    local ok,tracks=pcall(function() return animator:GetPlayingAnimationTracks() end)
    if not ok then return nil,nil end
    for _,track in ipairs(tracks) do
        if track.IsPlaying and track.Animation then
            local kind,label=diagClassForAnimation(track)
            if kind=='M1' or kind=='Skill' then
                combatDiag.cues[character]={at=now,kind=kind,id=diagAnimationId(track),label=label,confidence='Known or likely'}
                return kind,label
            end
        end
    end
    return nil,nil
end
