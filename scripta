end
local function bodyShiftLockDetected()
    -- Standard Roblox shift lock uses a centered mouse and camera-relative
    -- character rotation. Do not disable the mouse lock or alter the camera.
    local behavior=UserInputService.MouseBehavior
    bodyLock.mouseBehavior=tostring(behavior)
    return behavior==Enum.MouseBehavior.LockCenter
end
local function applyBodyLock(dt)
    if not alive or not settings.autoBlock or not settings.faceTarget then
        if bodyLock.humanoid then releaseBodyLock() end
        return
    end
    local rootCharacter,humanoid,root=getCharacter()
    local part=bodyLock.target
    if not root or not humanoid or humanoid.Health<=0 or humanoid.Sit or not part or
        not part.Parent or bodyLock.humanoid~=humanoid then
        if bodyLock.humanoid then releaseBodyLock() end
        return
    end
    local movement=getController('MovementController')
    local states=movement and movement.States
    local rag=rootCharacter and rootCharacter:FindFirstChild('IsRagdoll')
    if rag and rag:IsA('BoolValue') and rag.Value or (states and (states.RidingHorse or states.Aiming)) then
        bodyLock.blockedReason='Character restricted (horse/aim/ragdoll)'
        releaseBodyLock();return
    end
    local flat=Vector3.new(part.Position.X-root.Position.X,0,part.Position.Z-root.Position.Z)
    if flat.Magnitude<0.15 or flat.Magnitude>math.max(settings.bodyLockRange or 40,settings.blatantRange)+5 then
        bodyLock.blockedReason='Target too far / position invalid'
        releaseBodyLock();return
    end
    -- Shift Lock / camera-relative input can rotate the character before our
    -- callback. Disable Humanoid's default camera-facing rotation while tracking,
    -- then apply the chosen body heading AFTER the Camera and Character steps.
    -- Never change CurrentCamera, MouseBehavior, CameraOffset, or shift-lock state.
    local shiftLocked=bodyShiftLockDetected()
    bodyLock.shiftLockDetected=shiftLocked
    humanoid.AutoRotate=false
    local targetRotation=CFrame.lookAt(Vector3.zero,flat).Rotation
    local turnSpeed=6+math.clamp(settings.bodyLockSmoothness or 0.55,0.1,1)*25
    local alpha=1-math.exp(-turnSpeed*math.clamp(dt or 0.016,0,0.1))

    -- Using the actual root rotation as the interpolation base is ineffective
    -- when Shift Lock reorients it to camera yaw before every frame: the turn
    -- restarts forever. Carry forward the last body-lock rotation instead.
    local rootRotation=root.CFrame.Rotation
    local overrideShift=shiftLocked and settings.bodyLockShiftLock
    if overrideShift then
        bodyLock.shiftLockFrames=bodyLock.shiftLockFrames+1
        if bodyLock.lastRotation then
            local previous=bodyLock.lastRotation.LookVector
            local observed=rootRotation.LookVector
            local previousFlat=Vector3.new(previous.X,0,previous.Z)
            local observedFlat=Vector3.new(observed.X,0,observed.Z)
            if previousFlat.Magnitude>0.01 and observedFlat.Magnitude>0.01 and
                previousFlat.Unit:Dot(observedFlat.Unit)<math.cos(math.rad(12)) then
                bodyLock.shiftConflicts=bodyLock.shiftConflicts+1
            end
        end
    end
    local fromRotation=(overrideShift and bodyLock.lastRotation) or rootRotation
    local nextRotation=fromRotation:Lerp(targetRotation,alpha)
    root.CFrame=CFrame.new(root.Position)*nextRotation
    bodyLock.lastRotation=nextRotation
    local nextLook=Vector3.new(nextRotation.LookVector.X,0,nextRotation.LookVector.Z)
    if nextLook.Magnitude>0.01 then
        bodyLock.yawError=math.deg(math.acos(math.clamp(nextLook.Unit:Dot(flat.Unit),-1,1)))
    end
    bodyLock.frames=bodyLock.frames+1
    bodyLock.lastApply=os.clock()
    bodyLock.blockedReason=overrideShift and 'Shift Lock overridden (body only; camera intact)'
        or shiftLocked and 'Shift Lock detected; override disabled'
        or 'Active body turning (normal camera)'
end
local function closeProjectile(root)
    local tested={}
    local function relevant(obj)
        if not obj or tested[obj] then return false end
        tested[obj]=true
        local part=getPart(obj)
        if not part or not part:IsA('BasePart') then return false end
        local delta=root.Position-part.Position
        local distance=delta.Magnitude
        if distance>settings.skillReactDistance then return false end
        local velocity=part.AssemblyLinearVelocity
        return velocity.Magnitude>3 and delta:Dot(velocity)>0
    end
    for _,tag in ipairs({'Projectile','ProjectileHitbox','Bullet'}) do
        for _,obj in ipairs(CollectionService:GetTagged(tag)) do
            if relevant(obj) then return obj end
        end
    end
    for _,container in ipairs({workspace:FindFirstChild('Projectiles'),workspace:FindFirstChild('Bullets'),
        workspace:FindFirstChild('Effects')}) do
        if container then
            local checked=0
            for _,obj in ipairs(container:GetChildren()) do
                checked=checked+1
                if checked>120 then break end
                local name=obj.Name:lower()
                if name:find('projectile',1,true) or name:find('bullet',1,true)
                    or name:find('shot',1,true) or name:find('arrow',1,true) then
                    if relevant(obj) then return obj end
                end
            end
        end
    end
    return nil
end
