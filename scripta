local function checkCombat()
    local controller=getController('AttackController')
    local peers,hints=0,0
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LocalPlayer and p.Character then
            local h=p.Character:FindFirstChildOfClass('Humanoid')
            if h then peers=peers+1;if observedAttackKind(p.Character,h) then hints=hints+1 end end
        end
